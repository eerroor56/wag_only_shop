# ============================================================================
#  WAG Shop — переменные окружения
#  Скопируйте файл в .env и заполните значения:  cp .env.example .env
# ============================================================================

# development | production
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# true, если сервер стоит за reverse proxy (nginx, Caddy) — для корректного IP в rate limit
TRUST_PROXY=false

# ---------------------------------------------------------------- База данных
DATABASE_URL=postgres://wag:wag_password@localhost:5432/wag_shop

# ---------------------------------------------------------------- Адрес приложения
# Публичный HTTPS-адрес. Mini App: PUBLIC_URL/   Админка: PUBLIC_URL/admin/
# Для локальной разработки в Telegram используйте HTTPS-туннель (cloudflared / ngrok).
PUBLIC_URL=https://shop.example.com

# ---------------------------------------------------------------- Telegram Bot
# Токен от @BotFather
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# webhook (production) | polling (локально, без HTTPS) | disabled (только отправка сообщений)
# По умолчанию: webhook при NODE_ENV=production, иначе polling
BOT_MODE=polling
# Секрет webhook: 16–256 символов [A-Za-z0-9_-]. Сгенерировать: openssl rand -hex 32
WEBHOOK_SECRET=
# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot).
# Только они видят админ-панель и получают уведомления о заказах.
ADMIN_TELEGRAM_IDS=123456789
# Срок действия initData Mini App (секунды)
INIT_DATA_MAX_AGE_SECONDS=86400
# Адрес Bot API (менять только для собственного Bot API сервера)
TELEGRAM_API_ROOT=https://api.telegram.org

# ---------------------------------------------------------------- Магазин
SHOP_NAME=WAG Shop
SHOP_DESCRIPTION=Wag shop. Магазин брендовых вещей.
# Telegram менеджера, который связывается с клиентами (без @)
MANAGER_USERNAME=wag_on
# Часовой пояс для «заказов за сегодня» и дат в уведомлениях
SHOP_TIMEZONE=Europe/Moscow

# ---------------------------------------------------------------- Хранилище изображений
# local — файлы на диске сервера (UPLOAD_DIR), s3 — любое S3-совместимое хранилище
STORAGE_DRIVER=local
# По умолчанию apps/server/uploads
UPLOAD_DIR=
# Для STORAGE_DRIVER=s3:
S3_BUCKET=
S3_REGION=ru-central1
S3_ENDPOINT=https://storage.yandexcloud.net
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Публичный адрес файлов бакета (или CDN), без / в конце
S3_PUBLIC_URL=https://storage.yandexcloud.net/your-bucket
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------- Docker Compose (production)
# Используются только docker-compose.yml: домен для HTTPS (Caddy) и пароль PostgreSQL.
# PUBLIC_URL и DATABASE_URL compose выставит сам.
DOMAIN=shop.example.com
POSTGRES_PASSWORD=change_me_strong_password

# ---------------------------------------------------------------- Прочее
# Раздавать собранные frontend-приложения с backend (true для простого деплоя)
SERVE_STATIC=true
# Скорость рассылки, сообщений в секунду (лимит Telegram ≈ 30)
BROADCAST_RATE_PER_SECOND=25
# Применять миграции автоматически при старте сервера
MIGRATE_ON_START=false
